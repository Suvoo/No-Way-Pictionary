# Copy to .env (`make up` does it for you). Only TAVUS_API_KEY matters; empty = DEMO MODE (no video).

# Tavus API key (server-side only, never in the browser): https://platform.tavus.io -> API Keys
TAVUS_API_KEY=
# Optional. Leave empty: the server finds or creates Pip on your account at startup and logs its id.
TAVUS_PAL_ID=
# Optional: a stock face id from the Face Library. Empty = the PAL's default face.
TAVUS_FACE_ID=
# Optional: enables signed webhooks (post-call transcript). Any random string.
TAVUS_CALLBACK_SECRET=
# Public https URL of this server, needed for webhooks, e.g. https://doodle-with-pip.onrender.com
# (on Render it defaults to RENDER_EXTERNAL_URL, so leave it empty there)
PUBLIC_URL=

# Optional
DB_PATH=data/pictionary.db
CORS_ORIGINS=*
LOG_LEVEL=INFO
# Frontend build-time (optional): overrides the repo link in the footer and on the scoreboard
# (defaults to https://github.com/Suvoo/No-Way-Pictionary)
VITE_REPO_URL=
