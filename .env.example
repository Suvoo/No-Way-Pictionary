# Copy to .env. Leave the Tavus values empty to run in DEMO MODE (no video, typed guesses).

# Tavus API key (server-side only, never in the browser): https://platform.tavus.io -> API Keys
TAVUS_API_KEY=
# Printed by `make tavus-setup` (python -m backend.setup_tavus)
TAVUS_PAL_ID=
# Optional: a stock face id from the Face Library. Empty = the PAL's default face.
TAVUS_FACE_ID=
# Optional: enables signed webhooks (post-call transcript). Any random string.
TAVUS_CALLBACK_SECRET=
# Public https URL of this server, needed for webhooks, e.g. https://reverse-pictionary.onrender.com
PUBLIC_URL=

# Optional
DB_PATH=data/pictionary.db
CORS_ORIGINS=*
LOG_LEVEL=INFO
# Frontend build-time (optional): link shown in the footer and on the scoreboard
VITE_REPO_URL=
